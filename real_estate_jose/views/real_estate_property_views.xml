<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_real_estate_property_list" model="ir.ui.view">
        <field name="name">real.estate.property.list</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <list multi_edit="1">
                <field name="reference" optional="show"/>
                <field name="category_id" optional="show"/>
                <field name="name"/>
                <field name="description" optional="hide"/>
                <field name="price" optional="show"/>
                <field name="availability" widget="boolean_toggle" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_real_estate_property_form" model="ir.ui.view">
        <field name="name">real.estate.property.form</field>
        <field name="model">real.estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_reserve"
                            string="Reserve"
                            type="object"
                            class="btn-primary"
                            invisible="not availability"/>
                </header>
                <sheet>

                    <group>
                        <group>
                            <field name="reference"/>
                            <field name="name"/>
                            <field name="price"/>
                            <field name="category_id"/>
                        </group>

                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="availability" widget="boolean_toggle"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Information">
                            <field name="description"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>
</odoo>
