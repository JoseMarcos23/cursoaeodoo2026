<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_real_estate_visit_list" model="ir.ui.view">
        <field name="name">real.estate.visit.list</field>
        <field name="model">real.estate.visit</field>
        <field name="arch" type="xml">
            <list>
                <field name="property_id"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_real_estate_visit_form" model="ir.ui.view">
        <field name="name">real.estate.visit.form</field>
        <field name="model">real.estate.visit</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_draft"
                            string="Draft"
                            type="object"
                            invisible="state == 'draft'"/>

                    <button name="action_set_planned"
                            string="Planned"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'planned'"/>

                    <button name="action_set_done"
                            string="Done"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'done'"/>

                    <button name="action_set_cancelled"
                            string="Cancelled"
                            type="object"
                            invisible="state == 'cancelled'"/>

                    <field name="state"
                           widget="statusbar"
                           options="{'clickable': true}"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="property_id"/>
                            <field name="date"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_real_estate_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="res_model">real.estate.visit</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
